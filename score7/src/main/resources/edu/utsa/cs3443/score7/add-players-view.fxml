<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml" styleClass="screen"
           fx:controller="edu.utsa.cs3443.score7.controllers.AddPlayersController">
    <BorderPane styleClass="screen-content">
        <top>
            <VBox alignment="CENTER" spacing="10">
                <HBox alignment="CENTER_LEFT">
                    <Button text="Back" styleClass="header-button" onAction="#onBack"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Done" styleClass="header-button" onAction="#onDone"/>
                </HBox>
                <Label text="Add Players" styleClass="title"/>
                <Label fx:id="errorLabel" styleClass="error-label"/>
            </VBox>
        </top>
        <center>
            <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER">
                <VBox fx:id="playerList" alignment="TOP_CENTER" spacing="10">
                    <padding>
                        <Insets top="6" bottom="6"/>
                    </padding>
                </VBox>
            </ScrollPane>
        </center>
        <bottom>
            <VBox alignment="CENTER">
                <padding>
                    <Insets top="12"/>
                </padding>
                <Button text="+" styleClass="pill-button" onAction="#onAddPlayer"/>
            </VBox>
        </bottom>
    </BorderPane>

    <StackPane fx:id="overlay" styleClass="overlay-bg" visible="false">
        <VBox styleClass="dialog" alignment="CENTER" spacing="10" maxWidth="250" maxHeight="-Infinity">
            <Label text="Are You Sure You Want to Delete This Player?" styleClass="dialog-title"/>
            <Label fx:id="deleteNameLabel" styleClass="dialog-text"/>
            <Button text="Delete" styleClass="pill-button, small-pill" onAction="#onConfirmDelete"/>
            <Button text="Back" styleClass="pill-button, small-pill" onAction="#onCancelDelete"/>
        </VBox>
    </StackPane>
</StackPane>
